{
    "name": "Warp Crystal",
    "description": "Power for the magma cube that acts as the crystal's hitbox.",
    "type": "apoli:multiple",
    "dieres": {
        "type": "apoli:resource",
        "min": 0,
        "max": 1,
        "max_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "origins:action_on_entity_set",
                    "set": "*:*_set",
                    "bientity_action": {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "kill @s"
                        }
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "particle minecraft:explosion_emitter"
                },
                {
                    "type": "apoli:play_sound",
                    "sound": "minecraft:entity.generic.explode"
                },
                {
                    "type": "apoli:area_of_effect",
                    "radius": 4,
                    "bientity_action": {
                        "type": "apoli:add_velocity",
                        "z": 1
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tp ~ -300 ~"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "kill @s"
                }
            ]
        }
    },
    "die": {
        "type": "apoli:modify_damage_taken",
        "modifier": {
            "operation": "multiply_total_multiplicative",
            "amount": -1
        },
        "damage_condition": {
            "type": "apoli:in_tag",
            "tag": "minecraft:bypasses_invulnerability",
            "inverted": true
        },
        "bientity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:target_action",
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "*:*_dieres",
                        "change": 1
                    }
                },
                {
                    "type": "apoli:actor_action",
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "*:crystals_cooldown",
                        "change": -1000
                    }
                }
            ]
        }
    },
    "die2": {
        "type": "apoli:action_when_damage_taken",
        "cooldown": 200,
        "damage_condition": {
            "type": "apoli:in_tag",
            "tag": "minecraft:bypasses_invulnerability"
        },
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "*:*_dieres",
            "change": 1
        }
    },
    "invis": {
        "type": "apoli:invisibility",
        "render_armor": false,
        "condition": {
            "type": "apoli:constant",
            "value": true
        }
    },
    "set": {
        "type": "apoli:entity_set",
        "action_on_remove": {
            "type": "apoli:target_action",
            "action": {
                "type": "apoli:execute_command",
                "command": "say ough"
            }
        }
    },
    "callback": {
        "type": "apoli:action_on_callback",
        "entity_action_gained": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:play_sound",
                    "sound": "minecraft:block.end_gateway.spawn"
                },
                {
                    "type": "apoli:spawn_entity",
                    "entity_type": "minecraft:end_crystal",
                    "tag": "{Tags:[\"cryskwt.crystal\",\"origins.dontdmg\"],ShowBottom:0b,Invulnerable:1b}",
                    "bientity_action": {
                        "type": "apoli:add_to_entity_set",
                        "set": "*:*_set"
                    }
                }
            ]
        },
        "entity_action_lost": {
            "type": "apoli:change_resource",
            "resource": "*:*_dieres",
            "change": 1
        }
    },
    "extracall": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "rising_action": {
            "type": "apoli:selector_action",
            "selector": "@e[tag=cryskwt.crystal,type=end_crystal,sort=nearest,limit=1,distance=..0.1]",
            "bientity_action": {
                "type": "apoli:and",
                "actions": [
                    {
                        "type": "origins:add_to_entity_set",
                        "set": "*:*_set"
                    }
                ]
            }
        },
        "condition": {
            "type": "origins:entity_set_size",
            "set": "*:*_set",
            "comparison": "==",
            "compare_to": 0
        }
    },
    "n": {
        "type": "origins:resource",
        "min": 0,
        "max": 5,
        "hud_render": {
            "should_render": false
        }
    },
    "decay": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_n",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_n",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "hold_or_release": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:action_on_entity_set",
            "set": "*:*_set",
            "bientity_action": {
                "type": "apoli:target_action",
                "action": {
                    "type": "apoli:execute_command",
                    "command": "function cryskwt:loadtarget"
                }
            }
        },
        "falling_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "origins:action_on_entity_set",
                    "set": "*:*_set",
                    "bientity_action": {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "kill @s"
                        }
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute positioned ~ ~0.5 ~ run particle minecraft:explosion ~ ~ ~ 0.5 0.5 0.5 0 4"
                },
                {
                    "type": "apoli:spawn_entity",
                    "entity_type": "minecraft:end_crystal",
                    "tag": "{Tags:[\"cryskwt.crystal\",\"origins.dontdmg\"],ShowBottom:0b,Invulnerable:1b}",
                    "bientity_action": {
                        "type": "apoli:add_to_entity_set",
                        "set": "*:*_set"
                    }
                }
            ]
        },
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_n",
            "comparison": ">",
            "compare_to": 1
        }
    }
}