{
	"name": "Warping Web",
	"description": "You can spawn teleport crystals at your location.",
	"type": "origins:multiple",
    "n": {
        "type": "origins:resource",
        "min": 0,
        "max": 5,
        "hud_render": {
            "should_render": false
        }
    },
    "decay": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_n",
            "change": -1
        },
        "interval": 1,
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_n",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "key": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_n",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    "if_action": {
						"type": "apoli:and",
						"actions": [
							{
								"type": "apoli:execute_command",
								"command": "particle minecraft:end_rod ~ ~ ~ 1 1 1 0.1 20"
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:block.respawn_anchor.charge"
							}
						]
                    }
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_n",
                    "change": 2
                }
            ]
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.primary_active",
            "continuous": true
        },
		"condition": {
			"type": "apoli:and",
			"conditions": [
				{
					"type": "apoli:resource",
					"resource": "*:*_cooldown",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "apoli:sneaking",
					"inverted": true
				},
				{
					"type": "apoli:command",
					"command": "execute if entity @e[type=minecraft:end_crystal,distance=..2]",
					"comparison": "==",
					"compare_to": 0
				}
			]
		}
    },
    "hold_or_release": {
        "type": "origins:action_over_time",
        "entity_action": {
			"type": "apoli:change_resource",
			"resource": "*:*_spawn",
			"change": 1
		},
        "interval": 1,
        "falling_action": {
			"type": "apoli:and",
			"actions": [
				{
					"type": "apoli:if_else",
					"condition": {
						"type": "apoli:resource",
						"resource": "*:*_cooldown",
						"comparison": "==",
						"compare_to": 0
					},
					"if_action": {
						"type": "apoli:and",
						"actions": [
							{
								"type": "apoli:play_sound",
								"sound": "minecraft:block.respawn_anchor.deplete"
							}
						]
					}
				
				},
				{
					"type": "apoli:change_resource",
					"resource": "*:*_spawn",
					"operation": "set",
					"change": 0
				}
			]
		},
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_n",
            "comparison": ">",
            "compare_to": 1
        }
    },
	"spawn": {
		"type": "apoli:resource",
		"min": 0,
		"max": 60,
		"hud_render": {
			"bar_index": 0,
			"sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
			"condition": {
				"type": "apoli:resource",
				"resource": "*:*_spawn",
				"comparison": ">",
				"compare_to": 1
			}
		},
		"max_action": {
			"type": "apoli:and",
			"actions": [
				{
					"type": "apoli:spawn_entity",
					"entity_type": "minecraft:magma_cube",
					"tag": "{Tags:[\"cryskwt.crystal\",\"origins.dontdmg\"],NoAI:1b,Silent:1b,Size:3,NoGravity:1b,PersistenceRequired:1b}",
					"entity_action": {
						"type": "apoli:and",
						"actions": [
							{
								"type": "apoli:grant_power",
								"power": "cryskwt:stand/crystalslime",
								"source": "cryskwt:crystal"
							},
							{
								"type": "apoli:execute_command",
								"command": "tp ~ ~-0.05 ~"
							}
						]
					}
				},
				{
					"type": "apoli:execute_command",
					"command": "particle minecraft:end_rod ~ ~ ~ 1 1 1 0.1 20"
				},
				{
					"type": "apoli:execute_command",
					"command": "particle explosion_emitter"
				},
				{
					"type": "apoli:change_resource",
					"operation": "set",
					"resource": "*:*_spawn",
					"change": 0
				},
				{
					"type": "apoli:change_resource",
					"operation": "set",
					"resource": "*:*_n",
					"change": 0
				},
				{
					"type": "apoli:trigger_cooldown",
					"power": "*:*_cooldown"
				}
			]
		}
	},
	"cooldown": {
		"type": "apoli:cooldown",
		"cooldown": 200,
		"hud_render": {
			"should_render": true,
			"sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
			"bar_index": 0,
			"inverted": true
		}
	}
}